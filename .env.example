# NutriVision AI Environment Configuration Example
# Copy this file to .env to customize environment settings

# Application Settings
APP_ENV=production
DEBUG=False
PORT=8501

# TensorFlow Settings
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0

# Database Settings
DATABASE_PATH=food_tracker.db

# Optional External API Keys (e.g., USDA FoodData Central)
USDA_API_KEY=your_usda_api_key_here
